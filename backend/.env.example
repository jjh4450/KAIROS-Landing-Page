# 실행 모드: production(기본) | dev
# - production: S3 자격증명 필수, 누락 시 컨테이너 즉시 종료
# - dev: S3 없이도 동작 (백업/파일 R2 비활성, 경고만)
APP_ENV=production

# S3 자격증명 (AWS S3 또는 S3-호환 서비스: Cloudflare R2, MinIO, Wasabi, B2 등)
# 두 버킷 모두에 Object Read+Write 권한.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Endpoint
# - AWS S3       : 비워두거나 https://s3.<region>.amazonaws.com
# - Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# - MinIO 등     : 본인 호스트 URL
S3_ENDPOINT=

# Region
# - AWS         : us-east-1 / ap-northeast-2 등
# - R2 / MinIO  : auto
S3_REGION=auto

# 버킷 분리: SQLite 백업 / 첨부 파일
# - S3_BACKUP_BUCKET: Litestream이 SQLite WAL을 stream 백업 (메타데이터)
# - S3_FILES_BUCKET : PocketBase 파일 storage 직행 (첨부 이미지 등)
# 둘 다 비공개. 첨부는 사용자에게 서명 URL로만 노출됨.
S3_BACKUP_BUCKET=pocketbase-backup
S3_FILES_BUCKET=pocketbase-files

# PocketBase 설정 암호화용 (선택)
# 생성: openssl rand -hex 16
PB_ENCRYPTION_KEY=

# Go 메모리 소프트 리밋 (선택)
GOMEMLIMIT=256MiB

# 타임존 (선택)
TZ=Asia/Seoul

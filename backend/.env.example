# 실행 모드: production(기본) | dev
# - production: R2 자격증명 필수, 누락 시 컨테이너 즉시 종료
# - dev: R2 없이도 동작 (백업 비활성, 경고만)
APP_ENV=production

# Cloudflare R2 자격증명
# Dashboard > R2 > Manage R2 API Tokens > Create API Token
# 권한은 백업용 단일 버킷에 대해 Object Read+Write로 최소화 권장
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 버킷 정보
R2_BUCKET=pocketbase-backup
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# PocketBase 설정 암호화용 (선택)
# 생성: openssl rand -hex 16
PB_ENCRYPTION_KEY=

# Go 메모리 소프트 리밋 (선택)
GOMEMLIMIT=256MiB

# 타임존 (선택)
TZ=Asia/Seoul
